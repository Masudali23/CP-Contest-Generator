{
  "name": "cp-contest-generator-windows",
  "version": "2.0.0",
  "private": true,
  "description": "CP Contest Generator - Windows edition. Runs natively on Windows with PowerShell; no WSL, no Docker, no Linux subsystem required.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "db:init": "npm --prefix backend run db:init",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend run preview"
  }
}
