# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill in the values.
# Never commit the real .env - it is git-ignored.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=8000

# PostgreSQL -----------------------------------------------------------------
# Local:   postgresql://postgres:YOUR_PASSWORD@localhost:5432/cp_contest
# Neon:    postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cp_contest
# Set to true for managed Postgres that requires TLS when the URL itself has no
# sslmode parameter. A URL ending in ?sslmode=require already covers this.
DATABASE_SSL=false
# Skip certificate verification. Only for a self-signed server you control -
# it removes the protection against someone impersonating your database.
DATABASE_SSL_INSECURE=false

# Cache ----------------------------------------------------------------------
# Leave empty to use the built-in in-memory cache (recommended for local dev,
# and the reason no Redis install is needed on Windows).
# Local Redis / Memurai:  redis://localhost:6379
# Upstash:                rediss://default:PASSWORD@xxx.upstash.io:6379
REDIS_URL=

# Auth -----------------------------------------------------------------------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth (https://console.cloud.google.com/apis/credentials) ------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Gemini (https://aistudio.google.com/apikey) --------------------------------
# Optional: without it the report falls back to the built-in offline analyser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Codeforces ----------------------------------------------------------------
# Only change this to point at a mirror or proxy. Leave unset for the real API.
# CF_API_BASE=https://codeforces.com/api

# Frontend -------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# Cookies --------------------------------------------------------------------
# Leave unset for local development. In production with the frontend on a
# different domain, set COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=
COOKIE_SECURE=false
